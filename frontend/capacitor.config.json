{
  "appId": "cc.dinnerparty.foodmap",
  "appName": "东方饭联地图",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "includePlugins": [
      "@aparajita/capacitor-secure-storage",
      "@capacitor/app",
      "@capacitor/app-launcher",
      "@capacitor/camera",
      "@capacitor/filesystem",
      "@capacitor/keyboard",
      "@capacitor/share"
    ]
  },
  "plugins": {
    "Keyboard": {
      "resize": "native",
      "resizeOnFullScreen": true
    },
    "SystemBars": {
      "insetsHandling": "css",
      "initialViewportFitValueHint": "cover"
    }
  }
}
