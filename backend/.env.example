PORT=7000
HOST=127.0.0.1
JWT_SECRET=replace-with-a-long-random-value
# SQLite 数据文件；相对路径以 backend/ 为根，默认 data.sqlite。
DB_FILE=data.sqlite

# 跨域白名单（逗号分隔）。Capacitor App 默认 Origin（capacitor://localhost、https://localhost）已内置。
CORS_ALLOWED_ORIGINS=

# 生产环境地点/聚餐分享页的网页地址；本地开发时留空，按请求地址生成。
FRONTEND_BASE_URL=https://www.dinnerparty.cc

# 高德：JS API key + 安全密钥属于同一个“Web端(JS API)”应用，须一起更换（改完重启后端即可，前端无需重新构建）。
#   AMAP_JS_KEY  公开值，经 /api/amap/js-config 下发给网页和 App 加载地图 SDK；未配置时返回 503。
#   AMAP_JS_CODE 安全密钥，只在服务端经 /_AMapService 注入 SDK 请求；未配置时该代理返回 503。
# Web 服务 key（仅服务端使用，供 /api/amap/regeo、/api/amap/staticmap 及行程功能调用 restapi.amap.com）分开管理。
AMAP_JS_KEY=
AMAP_JS_CODE=
AMAP_WEB_SERVICE_KEY=

# 地点评价：每人每天可新评或改评的店铺数（北京时间 0 点重置，默认 10）。见 services/placeRatings.md
PLACE_RATING_DAILY_LIMIT=10

# 地点图片存储：local（默认，存 backend/uploads/）| oss（阿里云 OSS）。
# 老图迁移：node scripts/migrate_uploads_to_oss.js（先预演，再加 --apply）。
IMAGE_STORAGE=local
# 例：oss-cn-hangzhou。用 RAM 子账号，只授予 acs:oss:*:*:<bucket>/food/* 的 PutObject/GetObject 权限。
OSS_REGION=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# 可选：服务器与 Bucket 同地域的 ECS 可填内网 endpoint（如 oss-cn-hangzhou-internal.aliyuncs.com）
OSS_ENDPOINT=
# Bucket 内的目录（Bucket 与其他用途共用）
OSS_PREFIX=food
# 绑定到 Bucket 的自有 HTTPS 域名（不要用 xxx.oss-cn-xxx.aliyuncs.com 默认域名）。
# 数据库里存 <OSS_PUBLIC_BASE_URL>/<OSS_PREFIX>/<文件名>；前端 VITE_OSS_IMAGE_BASE_URL 应与之对应。
OSS_PUBLIC_BASE_URL=

# SQLite 异地备份：使用独立、私有的备份 Bucket 与 RAM 凭证，不回退到图片 OSS_*。
# 手工验证：npm run backup:database -- --local-only（不需要 OSS 配置，不访问网络）。
# 默认命令会上传；恢复、30 天生命周期与 Windows 定时任务见 infrastructure/doc/DATABASE_BACKUP.md。
# 相对路径以 backend/ 为根；仅成功上传后保留最近 N 份成功备份，失败与 local-only 产物需人工管理。
BACKUP_DIR=backups
BACKUP_LOCAL_KEEP=3
BACKUP_OSS_REGION=
BACKUP_OSS_BUCKET=
BACKUP_OSS_ACCESS_KEY_ID=
BACKUP_OSS_ACCESS_KEY_SECRET=
# 可选：使用临时凭证时填写，过期后须轮换。
BACKUP_OSS_STS_TOKEN=
# 可选：同地域内网 endpoint；连接始终使用 HTTPS。不需要公开域名。
BACKUP_OSS_ENDPOINT=
BACKUP_OSS_PREFIX=food-map/sqlite
BACKUP_UPLOAD_ATTEMPTS=3
BACKUP_UPLOAD_TIMEOUT_MS=120000

# Structured JSON logs (paths are relative to backend/ unless absolute)
LOG_LEVEL=info
LOG_DIR=logs
LOG_TO_FILE=true
LOG_TO_CONSOLE=true
# Console only shows warn/error by default; files still get everything at LOG_LEVEL.
LOG_CONSOLE_LEVEL=warn
LOG_PRETTY_CONSOLE=true
LOG_MAX_FILE_MB=20
LOG_RETENTION_DAYS=14
LOG_SLOW_REQUEST_MS=1500
DB_SLOW_QUERY_MS=100
DB_BUSY_TIMEOUT_MS=5000
# Successful requests under these prefixes are omitted to avoid tile/image log noise.
# Errors and slow requests are still logged.
LOG_NOISY_PATH_PREFIXES=/_AMapService,/uploads,/diagnostics/client-auth

# Semantic search (server-side only; never expose these as VITE_ variables)
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
EMBEDDING_TIMEOUT_MS=15000

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_MS=15000
DEEPSEEK_EXPANSION_TIMEOUT_MS=6000

# 日记算法通过私有服务调用；模型密钥在私有服务配置。手工日记不依赖它。
# 见 modules/journeys/doc/ALGORITHM_SERVICE.md。
JOURNEY_ALGORITHM_SERVICE_URL=
JOURNEY_ALGORITHM_SERVICE_TOKEN=
JOURNEY_ALGORITHM_CALLBACK_TOKEN=
JOURNEY_ALGORITHM_TIMEOUT_MS=120000
INTENT_EXPANSION_CACHE_TTL_MS=3600000

# Vector backfill/retry worker
VECTOR_AUTO_BACKFILL=true
VECTOR_BATCH_SIZE=20
VECTOR_RETRY_INTERVAL_MS=600000

# Public AI-search protection
AI_SEARCH_RATE_LIMIT=12
AI_SEARCH_MIN_SEMANTIC_SCORE=0.60
AI_EXPANDED_INTENT_MIN_SEMANTIC_SCORE=0.55
AI_PLACE_DETAIL_WEIGHT=0.25
AI_RELEVANCE_MIN_CONFIDENCE=0.68
AI_FALLBACK_RELEVANCE_MIN_SCORE=0.58
AI_LOCAL_PREFERENCE_MIN_SCORE=0.60
AI_LOCAL_MIN_DETAIL_COMPLETENESS=0.25
AI_REMOTE_SEARCH_RADIUS_KM=50
AI_REMOTE_PROXIMITY_WEIGHT=0.06

# QQ Bot（NapCat OneBot 11 正向 WebSocket，只连本机）。默认关闭；各功能开关互相独立。
QQ_BOT_ENABLED=false
QQ_BOT_WS_URL=ws://127.0.0.1:3001
# 与 NapCat onebot11_<QQ>.json 里 websocketServers[].token 相同的独立随机串
QQ_BOT_ACCESS_TOKEN=
# 专用机器人 QQ；NapCat 登录的账号不一致时拒绝连接
QQ_BOT_SELF_ID=
# 看门狗（script/watchdog.ps1）用：NapCat Shell 目录，含 NapCatWinBootMain.exe
QQ_BOT_NAPCAT_DIR=
# 群消息里的“在地图中查看”链接，必须是公网 HTTPS 网站地址（未设置时回退 FRONTEND_BASE_URL）
QQ_BOT_PUBLIC_WEB_URL=https://www.dinnerparty.cc
QQ_BOT_COMMANDS_ENABLED=true
QQ_BOT_PRIVATE_ENABLED=true
# 响应指令的群；未设置时与 QQ_BOT_NOTIFY_GROUP_IDS 相同
QQ_BOT_COMMAND_GROUP_IDS=
# 白名单同步：off | dry-run（只计算差异，不写入）| on（只增不删）
QQ_BOT_WHITELIST_MODE=dry-run
QQ_BOT_SYNC_GROUP_IDS=
QQ_BOT_SYNC_INTERVAL_MS=7200000
# 新地点群推送；关闭期间新增的地点不会补发
QQ_BOT_NOTIFY_ENABLED=false
QQ_BOT_NOTIFY_GROUP_IDS=
# 模糊指令和长指令提取（如 !创建xx餐厅，人均60）用 DeepSeek（沿用 DEEPSEEK_*）；关闭后只认精确指令
QQ_BOT_AI_ENABLED=true
# !随机 的默认中心（GCJ-02 “纬度,经度”）：没有定位记录的住民和未注册 QQ 使用；默认 B记鱼粥
QQ_BOT_RANDOM_CENTER=23.016488,113.394404
QQ_BOT_RANDOM_CENTER_NAME=B记鱼粥
# 查询 / 随机结果另发的地点卡片：tuwen（QQ 图文分享卡片，标题+地点详情+图片，点开直接进地图；
# 经 NapCat send_packet 发 OIDB 0xdc2_34，被拒或出错时自动改发链接）
# | miniapp（NapCat get_mini_app_ark，点开进入模板小程序，不能跳转网页）
# | link（单独发 /p/<id> 分享链接，电脑版 QQ 会展开成卡片）| off
QQ_BOT_CARD_MODE=tuwen
# miniapp 卡片借用的小程序模板：bili | weibo（卡片角标显示该小程序的名字和图标）
QQ_BOT_CARD_MINIAPP=bili
