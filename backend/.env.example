PORT=7000
HOST=127.0.0.1
# 在 backend/.env 中填入随机生成的 JWT 签名密钥（必填，至少 32 个字符；没设或太短时后端拒绝启动）。
# 生成命令：node -p "require('node:crypto').randomBytes(32).toString('hex')"
JWT_SECRET=
# 登录失败限流（可选，JSON，未写的项用默认值）：windowSeconds 时间窗秒数，accountIp / ip / account
# 分别是同一账号 + IP 段、同一 IP 段、同一账号在时间窗内允许的密码错误次数。线上数值只放 .env。
# LOGIN_FAILURE_LIMITS={"windowSeconds":900}
# SQLite 数据文件；相对路径以 backend/ 为根，默认 data.sqlite。
DB_FILE=data.sqlite

# 跨域白名单（逗号分隔）。Capacitor App 默认 Origin（capacitor://localhost、https://localhost）已内置。
CORS_ALLOWED_ORIGINS=

# 生产环境地点/聚餐分享页的网页地址；本地开发时留空，按请求地址生成。
FRONTEND_BASE_URL=https://www.dinnerparty.cc

# 高德：JS API key + 安全密钥属于同一个“Web端(JS API)”应用，须一起更换（改完重启后端即可，前端无需重新构建）。
#   AMAP_JS_KEY  公开值，经 /api/amap/js-config 下发给网页和 App 加载地图 SDK；未配置时返回 503。
#   AMAP_JS_CODE 安全密钥，只在服务端经 /_AMapService 注入 SDK 请求；未配置时该代理返回 503。
# Web 服务 key（仅服务端使用，供 /api/amap/regeo、/api/amap/staticmap 及行程功能调用 restapi.amap.com）分开管理。
AMAP_JS_KEY=
AMAP_JS_CODE=
AMAP_WEB_SERVICE_KEY=
# 地点的省 / 市 / 区由后台任务用上面的 Web 服务 key 补齐（地区筛选）；设为 false 关闭，没有 key 时也不启动。
# 见 modules/places/doc/README.md；一次补完：npm run places:regions
# PLACE_REGION_WORKER=true

# 地点评价：每人每天可新评或改评的店铺数（北京时间 0 点重置，默认 10）。见 modules/ratings/doc/placeRatings.md
PLACE_RATING_DAILY_LIMIT=10

# 地点图片存储：local（默认，存 backend/uploads/）| oss（阿里云 OSS）。
# 头像上传需要 oss。老图迁移：npm run images:migrate-oss（地点）或 npm run avatars:migrate-oss（头像），先预演，再加 -- --apply。
IMAGE_STORAGE=local
# 例：oss-cn-hangzhou。用 RAM 子账号，只授予 acs:oss:*:*:<bucket>/food/* 的 PutObject/GetObject 权限。
# 头像替换和账号注销还需要 acs:oss:*:*:<bucket>/<OSS_PREFIX>/avatars/* 的 oss:DeleteObject 权限。
OSS_REGION=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# 可选：服务器与 Bucket 同地域的 ECS 可填内网 endpoint（如 oss-cn-hangzhou-internal.aliyuncs.com）
OSS_ENDPOINT=
# Bucket 内的目录（Bucket 与其他用途共用）
OSS_PREFIX=food
# 绑定到 Bucket 的自有 HTTPS 域名（不要用 xxx.oss-cn-xxx.aliyuncs.com 默认域名）。
# 数据库里存 <OSS_PUBLIC_BASE_URL>/<OSS_PREFIX>/<文件名>；前端 VITE_OSS_IMAGE_BASE_URL 应与之对应。
OSS_PUBLIC_BASE_URL=

# 手机号短信验证码（注册与住民设置换绑；找回密码仍只走 QQ）。见 modules/accounts/doc/README.md。
# AccessKey 默认沿用上面的 OSS_ACCESS_KEY_*（也可用 SMS_ACCESS_KEY_ID/SECRET 单独配置）；
# 该 RAM 用户需要追加 dypns:SendSmsVerifyCode（境外号码另需 dysms:SendMessageToGlobe）。
# 中国大陆号码：号码认证服务 → 短信认证，签名只能选控制台“赠送签名”，模板默认 100001（登录/注册）与 100004（绑定新手机号）。
# 未填 SMS_SIGN_NAME 时获取短信验证码返回 503。
SMS_SIGN_NAME=
# SMS_TEMPLATE_REGISTER=100001
# SMS_TEMPLATE_CHANGE_PHONE=100004
# SMS_SCHEME_NAME=
# 其他国家或地区（含港澳台）：短信服务“国际/港澳台短信”的 SendMessageToGlobe，不需要签名和模板，正文由后端拼好。
# 按提交计费（运营商回执失败也收费），所以默认关闭：关闭时境外号码提示“暂不支持”，大陆号码不受影响。
# RAM 用户需要 dysms:SendMessageToGlobe。SenderID 可选（控制台“SenderID”；美国不支持）。
SMS_INTL_ENABLED=false
# SMS_INTL_SENDER_ID=
# SMS_INTL_CHANNEL_ID=
# 注册是否必须验证手机号。false（默认）时旧版客户端（注册表单没有手机号字段）仍可只凭 QQ 验证码注册，
# 日志记 auth.register.without_phone；旧版本淘汰后改为 true。
REGISTRATION_PHONE_REQUIRED=false

# SQLite 异地备份：使用独立、私有的备份 Bucket 与 RAM 凭证，不回退到图片 OSS_*。
# 手工验证：npm run backup:database -- --local-only（不需要 OSS 配置，不访问网络）。
# 默认命令会上传；恢复、30 天生命周期与 Windows 定时任务见 infrastructure/doc/DATABASE_BACKUP.md。
# 相对路径以 backend/ 为根；仅成功上传后保留最近 N 份成功备份，失败与 local-only 产物需人工管理。
BACKUP_DIR=backups
BACKUP_LOCAL_KEEP=3
BACKUP_OSS_REGION=
BACKUP_OSS_BUCKET=
BACKUP_OSS_ACCESS_KEY_ID=
BACKUP_OSS_ACCESS_KEY_SECRET=
# 可选：使用临时凭证时填写，过期后须轮换。
BACKUP_OSS_STS_TOKEN=
# 可选：同地域内网 endpoint；连接始终使用 HTTPS。不需要公开域名。
BACKUP_OSS_ENDPOINT=
BACKUP_OSS_PREFIX=food-map/sqlite
BACKUP_UPLOAD_ATTEMPTS=3
BACKUP_UPLOAD_TIMEOUT_MS=120000

# Structured JSON logs (paths are relative to backend/ unless absolute)
LOG_LEVEL=info
LOG_DIR=logs
LOG_TO_FILE=true
LOG_TO_CONSOLE=true
# Console only shows warn/error by default; files still get everything at LOG_LEVEL.
LOG_CONSOLE_LEVEL=warn
LOG_PRETTY_CONSOLE=true
LOG_MAX_FILE_MB=20
# 网络日志依法保存不少于六个月：小于 184 天的值按 184 天处理（默认 186）
LOG_RETENTION_DAYS=186
# 客户端源端口来自最外层代理写入的请求头（nginx: proxy_set_header X-Client-Port $remote_port;
# Caddy 直连入口: header_up X-Client-Port {http.request.remote.port}）；只在对端是受信任代理时采用。
LOG_CLIENT_PORT_HEADER=X-Client-Port

# ---- 防爬（http/doc/README.md#数据访问限流）----
# 信任哪些代理写的 X-Forwarded-For。不设 = true（旧行为，客户端能伪造 IP）；
# 源站 Caddy 覆盖写 X-Forwarded-For 以后（doc/CDN_CACHE.md#源站-caddy）改成 loopback
# TRUST_PROXY=loopback
# off / observe（默认，只记日志不拦）/ enforce（超过回 429）
ANTI_SCRAPE_MODE=observe
# 按策略与 guest / user 覆盖默认额度（JSON），线上数值只写在这里，例如：
# ANTI_SCRAPE_LIMITS={"tiles":{"guest":[{"distinct":true,"limit":30,"per":"day"}]}}
# 旧的整份标记快照 GET /places/markers：旧版 App 更新完以后设 off（回 410），并刷新 ESA 上这个路径的缓存
LEGACY_MARKER_SNAPSHOT=on
# 地图瓦片在内存里复用的时间；明细瓦片票据的签名密钥（不设时由 JWT_SECRET 派生）
TILE_SNAPSHOT_TTL_MS=15000
# TILE_TICKET_SECRET=
LOG_SLOW_REQUEST_MS=1500
DB_SLOW_QUERY_MS=100
DB_BUSY_TIMEOUT_MS=5000
# Successful requests under these prefixes are omitted to avoid tile/image log noise.
# Errors and slow requests are still logged.
LOG_NOISY_PATH_PREFIXES=/_AMapService,/uploads,/diagnostics/client-auth

# Semantic search (server-side only; never expose these as VITE_ variables)
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
EMBEDDING_TIMEOUT_MS=15000
# Rating profiles share the 4B API above; no MODEL_FEATURE_EMBEDDING_URL/TOKEN
# or separate encoder container is needed with research-full-nonchain-4b-v3.
MODEL_PROFILE_MODE=active
# Background extraction needs a longer timeout than search intent expansion.
MODEL_PROFILE_TIMEOUT_MS=60000
# Actual visible markers over this limit retain aggregates; details load models.
# Offscreen prefetch markers do not count with the updated web/iOS client.
# 0 defers all map-marker model scores. List/random/detail scores stay enabled.
MAP_EAGER_RATING_LIMIT=100

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_MS=15000
DEEPSEEK_EXPANSION_TIMEOUT_MS=6000

# 地点 AI 初筛（modules/places/doc/placeModeration.md）：明显简略、与美食和东方无关、含不良信息的新地点先只给创建者看，
# 创建者把自己的地点改出这类内容时修改先不生效，都交管理员在“地点修改申请”页复核。文字和图片都用上面的 DeepSeek。
# 模型未配置或调用失败时按通过处理；管理员（manage_places）新建或修改的地点不检查。false = 关闭（旧行为）
PLACE_MODERATION_ENABLED=true
PLACE_MODERATION_MIN_CONFIDENCE=0.7
PLACE_MODERATION_MAX_CHECKS=4
PLACE_MODERATION_TIMEOUT_MS=20000
# 留空用 DEEPSEEK_MODEL。必须是能看图的模型：deepseek-flash 可以，deepseek-v4-pro 看不到图片
PLACE_MODERATION_MODEL=

# 日记算法通过私有服务调用；模型密钥在私有服务配置。手工日记不依赖它。
# 见 modules/journeys/doc/ALGORITHM_SERVICE.md。
JOURNEY_ALGORITHM_SERVICE_URL=
JOURNEY_ALGORITHM_SERVICE_TOKEN=
JOURNEY_ALGORITHM_CALLBACK_TOKEN=
JOURNEY_ALGORITHM_TIMEOUT_MS=120000
# 数值操作默认复用上面的服务；可单独配置测试/部署入口，禁止写入前端环境
NUMERIC_ALGORITHM_SERVICE_URL=
NUMERIC_ALGORITHM_SERVICE_TOKEN=
ALGORITHM_DATASET_ID=primary
# 研究包默认禁用，先 dry-run；状态凭据与服务/地点回调凭据分开
RATING_EVIDENCE_EXPORT_ENABLED=false
RATING_EVIDENCE_STATUS_TOKEN=
RATING_EVIDENCE_ROOT=
INTENT_EXPANSION_CACHE_TTL_MS=3600000

# 场馆（denpawave 推送）：POST /internal/venues，落点后由 ?venue= 跳转解析。见 modules/venues/doc/README.md。
# 未配置 token 时该接口返回 503，不会放行。生成：openssl rand -hex 32
VENUE_TOKEN=
# 允许的来源 IP，逗号分隔；留空等于拒绝所有来源（不是不限制）
VENUE_ALLOWED_IPS=

# Vector backfill/retry worker
VECTOR_AUTO_BACKFILL=true
VECTOR_BATCH_SIZE=20
VECTOR_RETRY_INTERVAL_MS=600000

# Public AI-search protection
AI_SEARCH_RATE_LIMIT=12
# AI 搜索的候选与审核（modules/discovery/doc/README.md）：地图中心这个半径内的地点全部算相似度；
# 比最相似的低 0.12 以内、且不低于下面的绝对下限的进入排序，前 8 家交给模型审核
AI_SEARCH_RADIUS_KM=50
AI_CANDIDATE_MIN_SEMANTIC_SCORE=0.35
AI_PROXIMITY_WEIGHT=0.12
AI_PLACE_DETAIL_WEIGHT=0.25
AI_RELEVANCE_MIN_CONFIDENCE=0.5
AI_FALLBACK_RELEVANCE_MIN_SCORE=0.58
# 已停用（2026-11-18 起不再读取，旧 .env 里可以删掉）：AI_SEARCH_MIN_SEMANTIC_SCORE、AI_EXPANDED_INTENT_MIN_SEMANTIC_SCORE、
# AI_LOCAL_PREFERENCE_MIN_SCORE、AI_LOCAL_MIN_DETAIL_COMPLETENESS、AI_REMOTE_SEARCH_RADIUS_KM、AI_REMOTE_PROXIMITY_WEIGHT

# QQ Bot（NapCat OneBot 11 正向 WebSocket，只连本机）。默认关闭；各功能开关互相独立。
QQ_BOT_ENABLED=false
QQ_BOT_WS_URL=ws://127.0.0.1:3001
# 与 NapCat onebot11_<QQ>.json 里 websocketServers[].token 相同的独立随机串
QQ_BOT_ACCESS_TOKEN=
# 专用机器人 QQ；NapCat 登录的账号不一致时拒绝连接
QQ_BOT_SELF_ID=
# 看门狗（script/watchdog.ps1）用：NapCat Shell 目录，含 NapCatWinBootMain.exe
QQ_BOT_NAPCAT_DIR=
# 群消息里的“在地图中查看”链接，必须是公网 HTTPS 网站地址（未设置时回退 FRONTEND_BASE_URL）
QQ_BOT_PUBLIC_WEB_URL=https://www.dinnerparty.cc
QQ_BOT_COMMANDS_ENABLED=true
QQ_BOT_PRIVATE_ENABLED=true
# 响应指令的群；未设置时与 QQ_BOT_NOTIFY_GROUP_IDS 相同
QQ_BOT_COMMAND_GROUP_IDS=
# 白名单同步：off | dry-run（只计算差异，不写入）| on（只增不删）
QQ_BOT_WHITELIST_MODE=dry-run
QQ_BOT_SYNC_GROUP_IDS=
QQ_BOT_SYNC_INTERVAL_MS=7200000
# 新地点群推送；关闭期间新增的地点不会补发。每半小时（整点、半点）把这半小时新增的地点打包成一条合并转发，
# 国内地点带省市；没有新地点不发
QQ_BOT_NOTIFY_ENABLED=false
QQ_BOT_NOTIFY_GROUP_IDS=
# 每天三顿饭的提醒（北京时间，依次为早、午、晚餐，必须递增）；群未设置时与 QQ_BOT_NOTIFY_GROUP_IDS 相同，设为空则不发
# 文案在 modules/qqbot/runtime/mealReminderCopy.js；Bot 离线错过 20 分钟以上的那一顿当天不补发
QQ_BOT_MEAL_REMINDER_ENABLED=true
QQ_BOT_MEAL_REMINDER_TIMES=08:00,11:30,17:30
# QQ_BOT_MEAL_REMINDER_GROUP_IDS=
# 模糊指令和长指令提取（如 !创建xx餐厅，人均60）用 DeepSeek（沿用 DEEPSEEK_*）；关闭后只认精确指令
QQ_BOT_AI_ENABLED=true
# !随机 的默认中心（GCJ-02 “纬度,经度”）：没有定位记录的住民和未注册 QQ 使用；默认 B记鱼粥
# 各群可由群主 / 管理员用 !随机中心 另设本群中心（存数据库，不在这里配置）
QQ_BOT_RANDOM_CENTER=23.016488,113.394404
QQ_BOT_RANDOM_CENTER_NAME=B记鱼粥
# 查询 / 随机结果另发的地点卡片：tuwen（QQ 图文分享卡片，标题+地点详情+图片，点开直接进地图；
# 经 NapCat send_packet 发 OIDB 0xdc2_34，被拒或出错时自动改发链接）
# | miniapp（NapCat get_mini_app_ark，点开进入模板小程序，不能跳转网页）
# | link（单独发 /p/<id> 分享链接，电脑版 QQ 会展开成卡片）| off
QQ_BOT_CARD_MODE=tuwen
# miniapp 卡片借用的小程序模板：bili | weibo（卡片角标显示该小程序的名字和图标）
QQ_BOT_CARD_MINIAPP=bili

# 编辑评论文本证据：active 启用质量证据；shadow 只运行对照；off 停止评估。
# 公共分按质量证据规则启用有界加权；评分误差不是质量真实性标签。复用 DEEPSEEK_API_KEY/BASE_URL。
RATING_TEXT_EVIDENCE_MODE=active
RATING_TEXT_LLM_MODEL=deepseek-flash

# 小伙伴时间线接口开放范围：off（默认）| admin（管理员）| all（已登录住民）
ROOMS_AUDIENCE=off
# 每天北京时间 04:30 后排程，false 关闭
ROOM_SCHEDULER=true
# 审核小伙伴的名字和口头禅。关闭或未配置 DeepSeek 时直接公开
ROOM_TEXT_CHECK=true
# 留空沿用 PLACE_MODERATION_MIN_CONFIDENCE 的设置和默认值
ROOM_TEXT_MIN_CONFIDENCE=
