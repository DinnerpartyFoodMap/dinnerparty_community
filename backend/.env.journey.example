# Server-side connection to the separately deployed private algorithm service.
JOURNEY_ALGORITHM_SERVICE_URL=http://127.0.0.1:7100
JOURNEY_ALGORITHM_SERVICE_TOKEN=
# Separate bearer for service -> backend read-only local-place lookup.
JOURNEY_ALGORITHM_CALLBACK_TOKEN=
JOURNEY_ALGORITHM_TIMEOUT_MS=120000

# Host-side permission gates remain authoritative.
AMAP_WEB_SERVICE_KEY=
AMAP_JOURNAL_STORAGE_ALLOWED=false
AMAP_EXPORT_ALLOWED=false

TRAINING_LOCAL_PLACE_DATA_ALLOWED=false
FEEDBACK_EXPORT_SECRET=
